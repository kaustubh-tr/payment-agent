# OpenAI API key — required
OPENAI_API_KEY=sk-...

# Payment API base URL
PAYMENT_API_BASE_URL=...

# LLM model (default: gpt-5.4-mini)
OPENAI_MODEL_NAME=gpt-5.4-mini

# Max verification retries before locking out user
MAX_VERIFICATION_ATTEMPTS=...

# Max payment retries before closing payment collection
MAX_PAYMENT_ATTEMPTS=...
